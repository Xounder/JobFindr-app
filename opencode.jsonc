{
  "$schema": "https://opencode.ai/config.json",
  "command": {
    "jobfindr-pipeline:start": {
      "template": "Carregue a skill `jobfindr-pipeline` e inicie o pipeline.",
      "description": "Inicia o pipeline JobFindr do zero"
    },
    "jobfindr-pipeline:next": {
      "template": "Leia o arquivo `pipeline.yaml` na raiz do projeto para identificar o ponto de retomada. Carregue a skill `jobfindr-pipeline-next` e continue o pipeline de agentes do JobFindr de onde parou.",
      "description": "Continua o pipeline JobFindr de onde parou (lê pipeline.yaml)"
    },
    "learning-improvement": {
      "template": "Carregue a skill `learning-improvement`, analise a sessão atual e extraia DONE, WRONG, IMPROV, LEARN, NEXT. Após extrair, você DEVE carregar a skill `continuous-learning` IMEDIATAMENTE — sem perguntar ao usuário. A cadeia completa é: learning-improvement → continuous-learning → session-save, executada atomicamente. Nunca pare após o learning-improvement.",
      "description": "Avalia a sessão atual e extrai aprendizados (DONE, WRONG, IMPROV, LEARN, NEXT), depois continua automaticamente para continuous-learning → session-save"
    },
    "jobfindr-pipeline:plan": {
      "template": "Invoque o agente **Planning Analyst** via Task (`subagent_type: \"Planning Analyst\"`) para realizar análise de viabilidade, risco, impacto e abordagem técnica. O Planning Analyst criará os artefatos de planejamento em `.opencode/plan/<context>/` e o arquivo 'active.txt' em `.opencode/plan/` contendo `{active: [<context>], date: <ISO-8601-date>}`.",
      "description": "Invoca o Planning Analyst para análise de viabilidade e impacto"
    }
  }
}
