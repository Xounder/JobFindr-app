# ── Backend ──────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS origin for frontend dev server
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Provider timeouts (ms)
PROVIDER_TIMEOUT_MS=10000
GUPY_TIMEOUT_MS=10000
GREENHOUSE_TIMEOUT_MS=30000
ASHBY_TIMEOUT_MS=20000
LEVER_TIMEOUT_MS=20000
ASHBY_TIMEOUT_MS=15000
LEVER_TIMEOUT_MS=15000
WORKDAY_TIMEOUT_MS=15000

# Cache TTLs (seconds)
CACHE_JOBS_TTL=300
CACHE_TRUST_TTL=86400
CACHE_METADATA_TTL=3600

# Pagination
MAX_PAGE_SIZE=20

# ── Frontend (Vite) ──────────────────────────────────
VITE_API_URL=http://localhost:3001
